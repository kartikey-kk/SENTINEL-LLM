# ---------------------------------------------------------------------------
# SentinelLLM configuration. Copy to `.env` and fill in values.
# Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Core ---
SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO

# Admin key protects dashboard / policy / event endpoints. REQUIRED.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional client keys (comma-separated) for /inspect/* and /chat.
# When SENTINEL_REQUIRE_CLIENT_AUTH=true, callers must send X-API-Key.
SENTINEL_REQUIRE_CLIENT_AUTH=false
SENTINEL_CLIENT_API_KEYS=

# Secret used for HMAC hashing of audit fingerprints and for encrypting the
# PII restoration vault. REQUIRED in production.
SENTINEL_SECRET_KEY=change-me-to-another-long-random-string

# --- Docker Compose ---
# Required by docker-compose.yml (PostgreSQL password). Generate a random value.
POSTGRES_PASSWORD=change-me-postgres-password
# Ollama URL as seen from the backend container (host Ollama by default).
SENTINEL_OLLAMA_URL_DOCKER=http://host.docker.internal:11434
# PyTorch wheel index for the backend image (CPU default; e.g. https://download.pytorch.org/whl/cu124 for CUDA).
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# --- Storage ---
# Local development default is SQLite; Docker Compose overrides with Postgres.
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db
# postgres example: postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_REDIS_URL=redis://localhost:6379/0
# If Redis is unreachable, use an in-process store (single instance only).
SENTINEL_REDIS_OPTIONAL=true

# --- Audit / retention ---
SENTINEL_AUDIT_STORE_REDACTED_PREVIEW=true
SENTINEL_AUDIT_STORE_RAW_PROMPTS=false
SENTINEL_AUDIT_RETENTION_DAYS=30
SENTINEL_AUDIT_FAIL_CLOSED=true

# --- Limits ---
SENTINEL_MAX_REQUEST_BYTES=65536
SENTINEL_MAX_INPUT_CHARS=20000
SENTINEL_RATE_LIMIT_PER_MINUTE=120
SENTINEL_DETECTOR_TIMEOUT_SECONDS=20
SENTINEL_MAX_CONCURRENT_INFERENCES=2

# --- ML detectors ---
SENTINEL_ML_ENABLED=true
SENTINEL_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
SENTINEL_JAILBREAK_MODEL=jackhhao/jailbreak-classifier
SENTINEL_TOXICITY_MODEL=unitary/toxic-bert
SENTINEL_SPACY_MODEL=en_core_web_md
SENTINEL_ML_DEVICE=cpu
# Hugging Face cache shared between local runs and Docker (bind-mounted).
HF_HOME=./models_cache
# After `python scripts/download_models.py` has populated the cache, set to 1 so the
# gateway never contacts the Hugging Face Hub at startup (fully local operation).
HF_HUB_OFFLINE=0

# --- Policy file (tool permissions live in its `tools` section) ---
SENTINEL_POLICY_FILE=policies/default.yaml

# --- Local LLM (Ollama) ---
SENTINEL_OLLAMA_ENABLED=true
SENTINEL_OLLAMA_BASE_URL=http://localhost:11434
SENTINEL_OLLAMA_DEFAULT_MODEL=qwen2.5:3b

# --- Cloud LLM (any OpenAI-compatible chat completions API) ---
SENTINEL_CLOUD_ENABLED=false
SENTINEL_CLOUD_PROVIDER_NAME=openai_compatible
SENTINEL_CLOUD_BASE_URL=https://api.openai.com/v1
SENTINEL_CLOUD_API_KEY=
SENTINEL_CLOUD_DEFAULT_MODEL=gpt-4o-mini
SENTINEL_CLOUD_MODELS=
# Optional pricing (USD per 1M tokens) used only for cost reporting in experiments.
SENTINEL_CLOUD_PRICE_INPUT_PER_MTOK=0
SENTINEL_CLOUD_PRICE_OUTPUT_PER_MTOK=0

# --- Provider behaviour ---
SENTINEL_PROVIDER_TIMEOUT_SECONDS=120
SENTINEL_PROVIDER_MAX_RETRIES=2
# Cloud fallback changes privacy properties; it is OFF unless set explicitly.
SENTINEL_ALLOW_CLOUD_FALLBACK=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=
